import pygame
import random
import math

pygame.init()
WIDTH, HEIGHT = 800, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("ООп - просто космос")
clock = pygame.time.Clock()
FONT = pygame.font.SysFont('Arial', 16)

class SpaceObject:
    def __init__(self, x, y, radius, color):
        self.x = x
        self.y = y
        self.radius = radius
        self.color = color
        self.speed_x = random.uniform(-2, 2)
        self.speed_y = random.uniform(-2, 2)
        self.destroyed = False
    
    def move(self):
        
        self.x += self.speed_x
        self.y += self.speed_y
        
        # Пусть они будут внутри экрана
        if self.x - self.radius < 0 or self.x + self.radius > WIDTH:
            self.speed_x *= -1
        if self.y - self.radius < 0 or self.y + self.radius > HEIGHT:
            self.speed_y *= -1
    
    def draw(self, surface):
        pygame.draw.circle(surface, self.color, (int(self.x), int(self.y)), self.radius)
    
    def check_collision(self, other):
        distance = math.sqrt((self.x - other.x)**2 + (self.y - other.y)**2)
        return distance < self.radius + other.radius
    
    def on_collision(self, other):
        pass
    
    def update(self):
        self.move()
    
    def destroy(self):
        self.destroyed = True

class Asteroid(SpaceObject):
    def __init__(self, x, y):
        super().__init__(x, y, random.randint(15, 30), (150, 150, 150))  # Серый
    
    def on_collision(self, other):
        if isinstance(other, Asteroid):
            # два астероида отскакивают
            self.speed_x, other.speed_x = other.speed_x, self.speed_x
            self.speed_y, other.speed_y = other.speed_y, self.speed_y
