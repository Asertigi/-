            # с черной дырой астероид уничтожается, черная дыра набирает массу
            other.radius = math.sqrt(other.radius**2+self.radius**2)
            self.destroy()

class BlackHole(SpaceObject):
    def __init__(self, x, y):
        super().__init__(x, y, random.randint(25, 40), (255, 255, 0))  # Желтый
    
    def on_collision(self, other):
        if isinstance(other, BlackHole):
            # две дыры сливаются
            x = (self.x * self.radius + other.x * other.radius)/(self.radius + other.radius)
            y = (self.y * self.radius + other.y * other.radius)/(self.radius + other.radius)
            self.radius = math.sqrt(self.radius**2 + other.radius**2)
            self.x = x
            self.y = y
            other.destroy()

    def update(self):
        self.move()
        self.radius = self.radius - math.sqrt(self.radius)*0.005 #излучение Хокинга
        if self.radius < 5:
            self.destroy()
        
    def draw(self, surface):
        pygame.draw.circle(screen, self.color, (int(self.x), int(self.y)), self.radius, 3)
    
def spawn_random_objects(count):
    objects = []
    for _ in range(count):
        x = random.randint(50, WIDTH - 50)
        y = random.randint(50, HEIGHT - 50)
        
        if random.random() < 0.7:  #спауним (побольше астероидов)
            objects.append(Asteroid(x, y))
        else:
            objects.append(BlackHole(x, y))
    return objects

def main():
    running = True
    objects = spawn_random_objects(15)
    
    while running:
        screen.fill((0, 0, 20))
        
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    running = False
                elif event.key == pygame.K_SPACE:
                    objects.extend(spawn_random_objects(5))
            elif event.type == pygame.MOUSEBUTTONDOWN:
                x, y = pygame.mouse.get_pos()
                if event.button == 1:  # лкм астероид
                    objects.append(Asteroid(x, y))
                elif event.button == 3:  # пкм черная дыра
                    objects.append(BlackHole(x, y))
        
        # Обновление и отрисовка
        for obj in objects[:]:
            if obj.destroyed:
                objects.remove(obj)
                continue
            
            obj.update()
            obj.draw(screen)
            
            # Проверка столкновений
            for other in objects:
                if obj != other and obj.check_collision(other):
                    obj.on_collision(other)
        
        # Информация необходимая пользователю
        info_text = FONT.render(f"Объектов: {len(objects)} (Space - добавить, ЛКМ - астероид, ПКМ - черная дыра)", True, (255, 255, 255))
        screen.blit(info_text, (10, 10))
        
        pygame.display.flip()
        clock.tick(60)
    
    pygame.quit()

if __name__ == "__main__":
    main()
